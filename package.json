{
  "name": "eslint-plugin-typeorm-enterprise",
  "version": "1.0.1",
  "description": "ESLint plugin to prevent raw SQL usage in TypeORM applications and support enterprise backend governance.",
  "keywords": [
    "eslint",
    "eslintplugin",
    "typeorm",
    "sql",
    "governance",
    "backend",
    "enterprise",
    "security"
  ],
  "license": "MIT",
  "author": "alokraj68",
  "repository": {
    "type": "git",
    "url": "https://github.com/alokraj68/eslint-plugin-typeorm-enterprise.git"
  },
  "main": "./lib/index.cjs",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "require": "./lib/index.cjs",
      "import": "./lib/index.mjs",
      "types": "./lib/index.d.ts"
    },
    "./rules/no-raw-query": {
      "require": "./lib/rules/no-raw-query.cjs",
      "import": "./lib/rules/no-raw-query.mjs",
      "types": "./lib/rules/no-raw-query.d.ts"
    }
  },
  "files": [
    "lib",
    "tests",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node tests/no-raw-query.test.js",
    "lint": "eslint .",
    "ci": "npm run lint && npm run typecheck && npm run test",
    "release": "npm run ci && npm publish --access public"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.16.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
