#!/bin/sh
# Auto-bump the patch version on every commit to `dev`, then restage the
# manifest so the bump is part of the commit. Enable with:
#   git config core.hooksPath .githooks
#
# Version bumps happen ONLY on `dev`. `main` is updated by fast-forwarding it to
# `dev`, so it never gains its own version commit — no reverse sync needed.
set -e

# Only bump on the dev branch.
branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
if [ "$branch" != "dev" ]; then
  exit 0
fi

# Skip during rebase/merge/amend to avoid unwanted bumps.
if [ -f "$(git rev-parse --git-dir)/MERGE_HEAD" ] || [ -f "$(git rev-parse --git-dir)/rebase-merge" ] || [ -f "$(git rev-parse --git-dir)/rebase-apply" ]; then
  exit 0
fi

npm version patch --no-git-tag-version >/dev/null 2>&1 || exit 0
git add package.json package-lock.json 2>/dev/null || true
